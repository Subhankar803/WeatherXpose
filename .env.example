# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to Git.

# ── Database ──────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/weather_platform

# ── Redis Cache ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Auth / Security ───────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── External APIs ─────────────────────────────────────────
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=

WINDY_API_KEY=

GNEWS_API_KEY=
NEWSDATA_API_KEY=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=weather-platform-bot

TELEGRAM_BOT_TOKEN=

# ── Object Storage (media files) ─────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=weather-media

# ── Machine Learning ──────────────────────────────────────────
TRAINED_MODEL_PATH=app/ml/models/event_classifier.joblib

# ── App Settings ──────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True