# ── Database ──────────────────────────────────────────────
# Configured for local MySQL Workbench; fallback to SQLite if offline:
DATABASE_URL=

# ── Redis Cache ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Auth / Security ───────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=

# ── External APIs ─────────────────────────────────────────
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=

WINDY_API_KEY=
WINDY_POINT_KEY=
WINDY_WEBCAM_KEY=
WINDY_MAP_KEY=
OPENWEATHER_API_KEY=

GNEWS_API_KEY=
NEWSDATA_API_KEY=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=weather-platform-bot

TELEGRAM_BOT_TOKEN=

# ── Object Storage (media files) ─────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# ── Machine Learning ──────────────────────────────────────────
TRAINED_MODEL_PATH=app/ml/models/event_classifier.joblib

# ── Email Gateway (SMTP for real Email OTPs) ─────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=True

# ── App Settings ──────────────────────────────────────────
ENVIRONMENT=development
DEBUG=True
